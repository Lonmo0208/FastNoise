{
	"schemaVersion": 1,
	"id": "zfastnoise",
	"version": "${version}",
	"name": "Fast Noise Mod",
	"description": "This mod makes improvements to noise gen",
	"authors": [
		"ZenXArch"
	],
	"contact": {
		"mastodon": "https://mastodon.social/@ZenXArch",
		"discord": "https://discord.gg/RFSmd7debX",
		"sources": "https://codeberg.org/ZenXArch/example",
		"modrinth": "https://modrinth.com/mod/zenxarch-example"
	},
	"license": "Mozilla Public License 2.0",
	"icon": "assets/zfastnoise/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"org.codeberg.zenxarch.fastnoise.FastNoiseMod"
		],
		"client": [
			"org.codeberg.zenxarch.fastnoise.client.FastNoiseClient"
		]
	},
	"mixins": [
		"zfastnoise.mixins.json",
		{
			"config": "zfastnoise.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*"
	}
}